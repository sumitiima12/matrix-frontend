# Dependencies — rebuilt with `npm install`, never committed (this repo had ~141MB of node_modules tracked)
node_modules/

# Secrets & environment — must never be committed
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
.fuse_hidden*
*.swp
*~

# Vite cache / coverage
.vite/
coverage/

# L-02: build output is produced in CI/deploy, not committed (avoids source/build drift + huge diffs).
# After pulling this change, run once on your Mac:  git rm -r --cached dist
dist/

# L-03: Playwright artifacts are transient — keep them in CI with expiry, not in the repo.
# After pulling this change, run once on your Mac:  git rm -r --cached test-results playwright-report
test-results/
playwright-report/

# CI workflows are managed via the GitHub web UI (a Personal Access Token can't push .github/workflows
# without the `workflow` scope). Ignore any local copy so `git add -A` doesn't re-trigger that push block.
.github/
