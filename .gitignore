# Dependencies — rebuilt with `npm install`, never committed (this repo had ~141MB of node_modules tracked)
node_modules/

# Secrets & environment — must never be committed
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
.fuse_hidden*
*.swp
*~

# Vite cache / coverage
.vite/
coverage/

# NOTE: dist/ (the Vite build output) is intentionally NOT ignored here — this repo currently commits it.
# If your host builds from source instead of serving the committed dist/, add `dist/` below and run
# `git rm -r --cached dist` on your Mac.
